[Unit]
Description=Helmr Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/helmr/helmr.env
ExecStart=/usr/bin/node /opt/helmr/dist/src/cli.js start gateway
Restart=on-failure
RestartSec=5
User=helmr
Group=helmr
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/helmr /etc/helmr

[Install]
WantedBy=multi-user.target
