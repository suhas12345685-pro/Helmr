# Copy to /etc/helmr/helmr.env (chmod 600, owned by the helmr user) and edit.
# These satisfy the production gate in docs/production-readiness.md.

# Required. 32+ chars. Generate with: openssl rand -hex 24
HELMR_API_TOKEN=

# Required. Comma-separated HTTPS origins allowed to call the Hatchery API.
# Wildcards are rejected in production.
HELMR_ALLOWED_ORIGINS=https://hatchery.example.com

# Provider/model selected during onboarding, e.g. anthropic/claude-sonnet-4-5
HELMR_MODEL=

# One (or more) provider key matching HELMR_MODEL.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# GROQ_API_KEY=
# XAI_API_KEY=
# PERPLEXITY_API_KEY=

# Optional request-safety limits (defaults shown).
HELMR_MAX_BODY_BYTES=1048576
HELMR_RATE_LIMIT_PER_MINUTE=120
